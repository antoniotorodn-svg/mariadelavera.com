---
import CalendlyEmbed from './CalendlyEmbed.astro';
---

<section class="section" id="reservar">
  <div class="container">
    <div class="calendly-header">
      <h2 class="section-title">Reserva tu cita</h2>
      <p class="section-sub">
        Elige la modalidad que prefieras y selecciona el día y hora que mejor te convenga.
      </p>
    </div>

    <div class="calendly-toggle" role="tablist" aria-label="Modalidad de consulta">
      <button class="calendly-tab calendly-tab--active" id="tabIndividual" role="tab" aria-selected="true">Individual</button>
      <button class="calendly-tab" id="tabPareja" role="tab" aria-selected="false">En pareja</button>
    </div>

    <div class="calendly-grid">
      <div class="calendly-props">
        <div class="calendly-prop">
          <span class="calendly-prop__icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em"><path d="M20 6 9 17l-5-5" /></svg></span>
          <div><strong>100% personalizado</strong><br/>Planes adaptados a tus gustos, horarios y estilo de vida.</div>
        </div>
        <div class="calendly-prop">
          <span class="calendly-prop__icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em"><path d="M20 6 9 17l-5-5" /></svg></span>
          <div><strong>Educación nutricional</strong><br/>Entiende el porqué de cada pauta, sin dietas milagro.</div>
        </div>
        <div class="calendly-prop">
          <span class="calendly-prop__icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em"><path d="M20 6 9 17l-5-5" /></svg></span>
          <div><strong>Seguimiento real</strong><br/>Revisiones periódicas para ajustar tu plan contigo.</div>
        </div>
        <div class="calendly-prop">
          <span class="calendly-prop__icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em"><path d="M20 6 9 17l-5-5" /></svg></span>
          <div><strong>Presencial u online</strong><br/>En Centro Médico Arboleda (Boadilla) o desde donde estés.</div>
        </div>
      </div>

      <div class="calendly-panels">
        <div class="calendly-panel" id="panelIndividual" role="tabpanel">
          <CalendlyEmbed type="consulta" />
        </div>
        <div class="calendly-panel calendly-panel--hidden" id="panelPareja" role="tabpanel">
          <CalendlyEmbed type="pareja" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabI = document.getElementById('tabIndividual');
  const tabP = document.getElementById('tabPareja');
  const panI = document.getElementById('panelIndividual');
  const panP = document.getElementById('panelPareja');
  function selectTab(pareja) {
    if (!tabI || !tabP || !panI || !panP) return;
    tabI.classList.toggle('calendly-tab--active', !pareja);
    tabP.classList.toggle('calendly-tab--active', pareja);
    tabI.setAttribute('aria-selected', String(!pareja));
    tabP.setAttribute('aria-selected', String(pareja));
    panI.classList.toggle('calendly-panel--hidden', pareja);
    panP.classList.toggle('calendly-panel--hidden', !pareja);
  }
  tabI?.addEventListener('click', () => selectTab(false));
  tabP?.addEventListener('click', () => selectTab(true));
</script>

<style>
  .calendly-header {
    margin-bottom: var(--spacing-xl);
  }

  .calendly-toggle {
    display: flex;
    justify-content: center;
    gap: 0;
    margin: 0 auto 2rem;
    background: var(--sand);
    border-radius: 999px;
    padding: 5px;
    width: fit-content;
  }
  .calendly-tab {
    border: none;
    background: transparent;
    padding: 0.6rem 1.8rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-light);
    cursor: pointer;
  }
  .calendly-tab--active {
    background: var(--cta);
    color: var(--ink);
  }

  .calendly-props {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    justify-content: center;
  }
  .calendly-prop {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .calendly-prop__icon {
    flex: none;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cta);
    color: var(--ink);
    border-radius: 50%;
    font-size: 1.1rem;
  }

  .calendly-panel--hidden { display: none; }

  .calendly-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 900px) {
    .calendly-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .calendly-col__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.625rem 1.25rem;
    background: var(--sand);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    max-width: 180px;
    margin: 0 auto;
  }

  .calendly-col__icon {
    font-size: 1rem;
  }
</style>
