---
interface Props {
  name: string;
  href: string;
}

const { name, href } = Astro.props;
---

<a href={href} class="barrio-tag tag">
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /> <circle cx="12" cy="10" r="3" /></svg> {name}
</a>

<style>
  .barrio-tag {
    transition: var(--transition-fast);
  }

  .barrio-tag:hover {
    transform: scale(1.05);
    background-color: var(--gold);
    color: var(--white);
    border-color: var(--gold);
  }
</style>
