---
// Material formativo - 8 tarjetas
const materials = [
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M19.496 12a2.5 2.5 0 00.399-2.214A2 2 0 0020.32 6.5 2 2 0 0019 3a2 2 0 00-1.5.68 2 2 0 00-3.287.424 2.5 2.5 0 00-3.189 2.06A3 3 0 0012 12l4-4' /> <path d='M4 12a1 1 0 00-.99 1.133A9 9 0 0012 21a9 9 0 008.99-7.867A1 1 0 0020 12z' /> <path d='M7 21h10' /> <path d='M9.85 6.907A3.5 3.5 0 005.05 12' /></svg>",
    title: "Prioridades para Perder Grasa",
    description: "Aprende qué factores son realmente importantes para perder grasa de forma efectiva y sostenible."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><rect width='14' height='20' x='5' y='2' rx='2' ry='2' /> <path d='M12 18h.01' /></svg>",
    title: "Tutorial de MyFitnessPal",
    description: "Guía paso a paso para usar esta aplicación y hacer un seguimiento preciso de tu alimentación."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18' /> <path d='M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25' /> <circle cx='18' cy='20' r='2' /> <circle cx='8' cy='20' r='2' /></svg>",
    title: "Entendiendo el Etiquetado",
    description: "Descifra las etiquetas nutricionales y aprende a tomar decisiones informadas en el supermercado."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M16 17h6v-6' /> <path d='m22 17-8.5-8.5-5 5L2 7' /></svg>",
    title: "Formas de Medir el Progreso",
    description: "Más allá de la báscula: conoce todas las formas de evaluar tu avance de manera objetiva."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M6 18h8' /> <path d='M3 22h18' /> <path d='M14 22a7 7 0 1 0 0-14h-1' /> <path d='M9 14h2' /> <path d='M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z' /> <path d='M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3' /></svg>",
    title: "Metabolismo: Parte I",
    description: "Entiende cómo funciona tu metabolismo y qué factores influyen en tu gasto energético."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915' /> <circle cx='12' cy='12' r='3' /></svg>",
    title: "Metabolismo: Parte II",
    description: "Profundiza en adaptaciones metabólicas, déficit calórico y estrategias de optimización."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M12 18V5' /> <path d='M15 13a4.17 4.17 0 01-3-4 4.17 4.17 0 01-3 4' /> <path d='M17.707 6.294A3 3 0 1012 5a3 3 0 10-5.707 1.294' /> <path d='M17.996 5.125a4 4 0 012.526 5.77' /> <path d='M18 18a4 4 0 002-7.465' /> <path d='M19.967 17.482a4 4 0 11-7.967.517 4 4 0 11-7.967-.517' /> <path d='M6 18a4 4 0 01-2-7.465' /> <path d='M6.004 5.125a4 4 0 00-2.526 5.77' /></svg>",
    title: "Mentalidad / Autosabotaje",
    description: "Identifica patrones mentales que te frenan y desarrolla una mentalidad ganadora."
  },
  {
    emoji: "<svg xmlns='http://www.w3.org/2000/svg' width='1em' height='1em' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline-block;vertical-align:-0.12em'><path d='M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2' /> <path d='M7 2v20' /> <path d='M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7' /></svg>",
    title: "Comidas fuera de casa",
    description: "Estrategias prácticas para mantener tus objetivos cuando comes fuera o viajas."
  }
];
---

<div class="material-grid">
  {materials.map(item => (
    <div class="material-card">
      <div class="material-icon-wrap">
        <span class="material-emoji" set:html={item.emoji} />
      </div>
      <h3 class="material-title">{item.title}</h3>
      <p class="material-desc">{item.description}</p>
    </div>
  ))}
</div>

<style>
  .material-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .material-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .material-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .material-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: var(--spacing-lg) var(--spacing-md);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
    transition: all var(--transition-base);
    text-align: center;
  }

  .material-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
  }

  .material-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-sm);
    transition: all var(--transition-base);
  }

  .material-card:hover .material-icon-wrap {
    background: var(--gold);
    transform: scale(1.05);
  }

  .material-emoji {
    font-size: 1.25rem;
  }

  .material-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .material-desc {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.55;
    margin: 0;
  }
</style>
